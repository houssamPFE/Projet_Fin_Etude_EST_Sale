APP_NAME=Nexora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nexora
DB_USERNAME=nexora
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=nexora
REVERB_APP_KEY=nexora-key
REVERB_APP_SECRET=nexora-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SANCTUM_TOKEN_EXPIRATION=15

# AI driver: 'openai' (direct API) or 'n8n' (workflow orchestration)
AI_DRIVER=openai

# n8n
N8N_BASE_URL=http://n8n:5678
N8N_SECRET=change-me-in-production
N8N_WEBHOOK_ANALYZE=/webhook/analyze-message
N8N_WEBHOOK_MODERATE=/webhook/moderate-content
N8N_WEBHOOK_SUMMARIZE=/webhook/summarize-conversation

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Qdrant
QDRANT_HOST=http://qdrant:6333
QDRANT_COLLECTION=nexora_knowledge

# AWS / MinIO (local dev)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=nexora
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# Browser-facing URL (Docker network = "minio:9000", browser = "localhost:9000")
AWS_URL=http://localhost:9000/nexora

# Stripe
STRIPE_KEY=pk_test_placeholder
STRIPE_SECRET=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# CMI (Morocco)
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_BASE_URL=

# Email
# Local dev with Mailpit:
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
#
# Real SMTP example (Brevo / production):
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-login
# MAIL_PASSWORD=your-smtp-key
BREVO_API_KEY=
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@nexora.ma
MAIL_FROM_NAME=Nexora

# Firebase FCM
FCM_SERVER_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=${FRONTEND_URL}/api/v1/auth/google/callback

# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=${FRONTEND_URL}/api/v1/auth/facebook/callback
